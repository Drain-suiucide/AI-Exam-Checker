# Пример конфигурации окружения backend AI Exam Checker.
# Скопируйте в backend/.env и при необходимости измените значения.
# СЕКРЕТЫ В РЕПОЗИТОРИЙ НЕ ДОБАВЛЯТЬ: .env игнорируется Git.

# --- окружение ---
ENVIRONMENT=development
DEBUG=false

# --- backend ---
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
# Origin'ы фронтенда, через запятую. В dev прокси Vite делает origin единым,
# поэтому CORS не нужен (ADR-001). Заполнять только при обращении к API напрямую.
CORS_ORIGINS=
ALLOW_UNAPPROVED_CONFIG=false

# --- база данных ---
# На этапе каркаса /health не зависит от БД. Подключение задаётся в compose;
# локально можно оставить пустым.
# DATABASE_URL=postgresql+psycopg://exam_checker:exam_checker_local@localhost:5432/exam_checker

# --- режимы адаптеров ---
DEMO_MODE=true
OCR_ENGINE=mock
LLM_PROVIDER=mock
